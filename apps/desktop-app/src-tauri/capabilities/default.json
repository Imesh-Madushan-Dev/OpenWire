{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege set: window chrome control, logging, and opening the developer's GitHub page. No filesystem, shell, or HTTP access is granted to the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/Imesh-Madushan-Dev" }]
    }
  ]
}